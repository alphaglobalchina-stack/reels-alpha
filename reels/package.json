{
  "name": "alpha-reels",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "render:reel1": "remotion render Reel1 ../out/reel1.mp4 --codec=h264",
    "render:reel2": "remotion render Reel2 ../out/reel2.mp4 --codec=h264 --gl=swangle",
    "render:reel3": "remotion render Reel3 ../out/reel3.mp4 --codec=h264",
    "render:all": "npm run render:reel1 && npm run render:reel2 && npm run render:reel3",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "^4.0.532",
    "@remotion/google-fonts": "^4.0.532",
    "@remotion/media": "^4.0.532",
    "@remotion/paths": "^4.0.532",
    "@remotion/shapes": "^4.0.532",
    "@remotion/three": "^4.0.532",
    "@remotion/transitions": "^4.0.532",
    "@types/d3-geo": "^3.1.1",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "gsap": "^3.15.0",
    "lucide": "^1.49.0",
    "lucide-react": "^1.49.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}

{
  "name": "alpha-reels",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "render:reel1": "remotion render Reel1 ../out/reel1.mp4 --codec=h264",
    "render:reel2": "remotion render Reel2 ../out/reel2.mp4 --codec=h264",
    "render:reel3": "remotion render Reel3 ../out/reel3.mp4 --codec=h264",
    "render:all": "npm run render:reel1 && npm run render:reel2 && npm run render:reel3",
    "typecheck": "tsc --noEmit",
    "render:alpha": "remotion render AlphaOpening ../out/alpha-opening-1080x1920-60fps.mp4 --codec=h264 --crf=19 --audio-codec=aac --audio-bitrate=256k",
    "render:alpha30": "ffmpeg -y -i ../out/alpha-opening-1080x1920-60fps.mp4 -vf fps=30 -c:v libx264 -crf 21 -preset slow -pix_fmt yuv420p -movflags +faststart -c:a copy ../out/alpha-opening-1080x1920-30fps.mp4",
    "sound:alpha": "cd .. && python3 pipeline/sound.py"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "^4.0.532",
    "@remotion/google-fonts": "^4.0.532",
    "@remotion/media": "^4.0.532",
    "@remotion/paths": "^4.0.532",
    "@remotion/shapes": "^4.0.532",
    "@remotion/transitions": "^4.0.532",
    "lucide": "^1.49.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
